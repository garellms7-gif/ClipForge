# Comma-separated list of allowed CORS origins.
# Add your Vercel frontend URL here when deploying.
ALLOWED_ORIGINS=http://localhost:3000

# Supabase project credentials (required for authentication)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google OAuth credentials for YouTube publishing.
# Create a project in Google Cloud Console, enable YouTube Data API v3,
# and create an OAuth 2.0 Web Client ID.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match exactly what's listed in Google Cloud Console authorized redirect URIs.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback
# Frontend URL — used to redirect back after OAuth completion.
FRONTEND_URL=http://localhost:3000

# Uncomment the line below for local development when running over HTTP (not HTTPS).
# This tells google-auth-oauthlib to allow insecure transport (HTTP).
# NEVER set this in production.
# OAUTHLIB_INSECURE_TRANSPORT=1
