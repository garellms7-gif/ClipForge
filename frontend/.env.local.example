# Base URL of the ClipForge FastAPI backend
# In production, set this to your Railway or Render deployment URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Supabase project credentials (required for authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
